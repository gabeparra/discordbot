# Discord application credentials (https://discord.com/developers/applications)
DISCORD_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-discord-application-client-id
# Optional: set to a single server ID for instant slash command updates during development
DISCORD_GUILD_ID=

# Tenor v2 API key (https://developers.google.com/tenor)
TENOR_API_KEY=your-tenor-api-key

# PostgreSQL connection (used by both the bot and docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_DB=discordbot
PGHOST=localhost
PGPORT=5432

# Optional bot customization
WELCOME_CHANNEL_NAME=general
CURRENCY_NAME=coins
DAILY_REWARD=50
DAILY_COOLDOWN_HOURS=24
